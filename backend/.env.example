# Copy this file to .env and adjust as needed.
# Phase 0: local dev uses a file-based SQLite database (zero setup).

# App
APP_NAME="GoldenLine"
ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Database
# SQLite (default for local dev):
DATABASE_URL=sqlite:///./dev.db

# PostgreSQL (use later / in production) - example:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/emergency_capacity

# FR-4: Google Maps Directions API key. Leave unset to use the labelled stub route.
# GOOGLE_MAPS_API_KEY=your-key-here

# FR-16 tier 1: hospital HMS integration gateway. When set, the HMS sync tier does
# a real GET {HMS_API_BASE_URL}/hospitals/{hospital_id}/beds -> {"general","ICU"}.
# Leave unset to use a labelled mock feed. (Tier 2, Google Sheets, needs no key —
# a real docs.google.com sheet URL is read via its public CSV export.)
# HMS_API_BASE_URL=https://hms-gateway.example/api
# HMS_API_TOKEN=optional-bearer-token

# FR-11: JWT signing key — CHANGE THIS in production.
# AUTH_SECRET=replace-with-a-long-random-value
# FR-11: seeded demo staff accounts each have password "<user_id>.sih2026"
# (PBKDF2-hashed in the DB). Provision real passwords and drop the seeds for prod.
# FR-11: reject plain HTTP. Local dev uses HTTP so this is off by default; a
# production deployment MUST terminate TLS and set FORCE_HTTPS=true (behind a
# proxy that sets X-Forwarded-Proto: https).
# FORCE_HTTPS=true
