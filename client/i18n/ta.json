{
  "brand.name": "GoldenLine",
  "brand.tagline": "ஒவ்வொரு அவசரநிலைக்கும் சரியான படுக்கைக்கும் இடையேயான பொன் இணைப்பு.",
  "hero.headline": "ஒவ்வொரு நொடியும் முக்கியம். ஒவ்வொரு படுக்கையும் கூட.",
  "hero.subheadline": "குடும்பங்கள், ஆம்புலன்ஸ்கள், மருத்துவமனைகள் மற்றும் இரத்த வங்கிகளை நிகழ்நேரத்தில் இணைக்கும் ஒரே ஒருங்கிணைந்த அமைப்பு.",
  "hero.feature1.title": "உடனடி மருத்துவமனை பொருத்தம்",
  "hero.feature1.body": "தூரம், திறன் மற்றும் கிடைக்கும் படுக்கைகளின் அடிப்படையில் வரிசைப்படுத்தப்படும் — யூகம் இல்லை.",
  "hero.feature2.title": "ஒரு படுக்கை கூட இரட்டிப்பாக பதிவு செய்யப்படாது",
  "hero.feature2.body": "ஒவ்வொரு படுக்கை பூட்டும் அணுவளவு — இரு ஆம்புலன்ஸ்கள் ஒரே படுக்கையை ஒருபோதும் வெல்ல முடியாது.",
  "hero.feature3.title": "இறுதி முடிவு எப்போதும் ஒரு மனிதரிடம்",
  "hero.feature3.body": "ஒவ்வொரு தானியங்கி எச்சரிக்கையும் ஒரு நபரால் மதிப்பாய்வு செய்யப்பட்டு முடிக்கப்படும், தானாக அல்ல.",
